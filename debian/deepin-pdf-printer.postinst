#!/bin/sh
# deepin-pdf-printer postinst — 安装后自动创建 CUPS 虚拟打印机
# 幂等：打印机已存在则跳过；失败不阻断 dpkg 安装（返回 0）
set -e

PRINTER="Deepin-PDF"
LPADMIN=/usr/sbin/lpadmin
LPSTAT=/usr/bin/lpstat
PPD=/usr/share/ppd/cupsfilters/Generic-PDF_Printer-PDF.ppd

# 检查 PPD 是否存在（cups-filters 未装时跳过）
if [ ! -f "$PPD" ]; then
    echo "deepin-pdf-printer: PPD 不存在 ($PPD)，跳过打印机创建" >&2
    exit 0
fi

# 幂等：打印机已存在则不重复创建
if $LPSTAT -p "$PRINTER" >/dev/null 2>&1; then
    echo "deepin-pdf-printer: 打印机 $PRINTER 已存在，跳过" >&2
    exit 0
fi

# 创建打印机（backend 为 root 运行，直接 lpadmin 即可）
if $LPADMIN -p "$PRINTER" -E -v deepinpdf:/ -P "$PPD" 2>/dev/null; then
    echo "deepin-pdf-printer: 已创建打印机 $PRINTER" >&2
else
    # 创建失败不致命（用户可在控制中心手动创建）
    echo "deepin-pdf-printer: 创建打印机 $PRINTER 失败，请手动在控制中心创建" >&2
fi

exit 0
