#!/usr/bin/env python3
"""dde-pdf — CUPS 虚拟 PDF 打印机 backend（POC 版）

CUPS backend 调用约定:
    backend job user title num-copies options [filename]
数据从 filename 或 stdin 读取（CUPS 过滤器链已转换为 PDF）。

行为:
    - 将接收到的 PDF 数据写入 <用户主目录>/PDF/ 目录
    - 文件名: <title>-<jobid>-<时间戳>.pdf
    - 兼容 CUPS 的 discover 模式（无参数时输出设备信息）

部署位置: /usr/lib/cups/backend/ddepdf
"""
import os
import sys
import time
import pwd
import shlex
import configparser


def discover():
    """CUPS 设备发现模式：无参数调用时打印支持的设备。"""
    print('direct ddepdf "Unknown" "DDE PDF Virtual Printer"')
    print('network ddepdf "Unknown" "DDE PDF Virtual Printer"')


def sanitize_filename(name: str, max_len: int = 60) -> str:
    """清洗文件名，去掉路径分隔符和特殊字符。"""
    name = os.path.basename(name or 'print')
    keep = []
    for ch in name:
        if ch.isalnum() or ch in '._- ':
            keep.append(ch)
    cleaned = ''.join(keep).strip()
    if not cleaned:
        cleaned = 'print'
    return cleaned[:max_len]


def get_output_dir(username: str) -> str:
    """获取用户 PDF 输出目录（不存在则创建）。

    backend 以 root 运行（权限 700），创建目录后 chown 给目标用户，
    确保用户可访问。目录已存在时（如用户手建）仅校正属主。

    优先读取控制中心插件的配置（QSettings ini 文件）中的 outputDir，
    未配置时回退到 <用户主目录>/PDF/。
    """
    try:
        pw = pwd.getpwnam(username)
        home = pw.pw_dir
        uid = pw.pw_uid
        gid = pw.pw_gid
    except KeyError:
        home = os.path.expanduser('~')
        uid = gid = -1

    outdir = os.path.join(home, 'PDF')

    # 读取控制中心插件写入的配置（QSettings NativeFormat = ini）
    # 配置文件: ~/.config/org.deepin.dde.pdfprinter/pdfprinter.conf
    conf_path = os.path.join(home, '.config', 'org.deepin.dde.pdfprinter', 'pdfprinter.conf')
    try:
        parser = configparser.ConfigParser()
        with open(conf_path, encoding='utf-8') as f:
            parser.read_file(f)
        configured = parser.get('General', 'outputDir', fallback='').strip()
        if configured:
            # 展开 ~ 和变量（QSettings 存的是展开后的绝对路径，防御性处理）
            configured = os.path.expanduser(os.path.expandvars(configured))
            if os.path.isabs(configured):
                # 【安全加固】输出目录必须位于用户家目录下（backend 以 root 运行，
                # 若允许任意路径，用户可配置 /etc/cron.d 等系统目录 → root 写入
                # 任意位置 = 本地提权）。
                real_conf = os.path.realpath(configured)
                real_home = os.path.realpath(home)
                if real_conf == real_home or real_conf.startswith(real_home + os.sep):
                    outdir = configured
                else:
                    print(f'WARN: outputDir 越界（非用户家目录），回退默认 {outdir}',
                          file=sys.stderr)
    except (OSError, configparser.Error):
        pass  # 配置缺失或损坏时回退默认目录

    # 【最终防线】默认/配置后的输出目录再做一次 realpath 校验：
    # 目录本身或其父组件可能是符号链接（如 ~/PDF → /etc 逃逸），
    # realpath 解析后必须仍位于用户家目录内，否则拒绝（防 root 写系统目录）。
    real_out = os.path.realpath(outdir)
    real_home = os.path.realpath(home)
    if not (real_out == real_home or real_out.startswith(real_home + os.sep)):
        print(f'WARN: 输出目录 {outdir} 解析后越界（symlink 逃逸？），回退 {home}/PDF',
              file=sys.stderr)
        outdir = os.path.join(home, 'PDF')
        real_out = os.path.realpath(outdir)
        if not (real_out == real_home or real_out.startswith(real_home + os.sep)):
            print('ERROR: 家目录解析异常，拒绝写入（安全起见）', file=sys.stderr)
            return None

    try:
        os.makedirs(outdir, exist_ok=True)
        if uid != -1:
            os.chown(outdir, uid, gid)
    except PermissionError:
        # 目录不可访问时尝试用 su 切到用户创建（非 root 运行兜底）
        import subprocess
        subprocess.run(['su', '-s', '/bin/sh', '-c',
                        f'mkdir -p {shlex.quote(outdir)}', username],
                       check=False)
    return outdir


def get_filename_template(username: str) -> str:
    """获取用户配置的输出文件名模板（控制中心设置页可自定义）。

    默认 '{title}-{jobid}-{date}-{time}'（保持历史行为：标题-作业ID-时间戳）。
    支持占位符：{title} 原文档名（清洗后） / {jobid} CUPS 作业ID /
               {date} YYYYMMDD / {time} HHMMSS
    读取与输出目录同一配置文件（~/.config/org.deepin.dde.pdfprinter/pdfprinter.conf）。
    """
    try:
        home = pwd.getpwnam(username).pw_dir
    except KeyError:
        home = os.path.expanduser('~')
    conf_path = os.path.join(home, '.config', 'org.deepin.dde.pdfprinter', 'pdfprinter.conf')
    try:
        parser = configparser.ConfigParser()
        with open(conf_path, encoding='utf-8') as f:
            parser.read_file(f)
        tpl = parser.get('General', 'filenameTemplate', fallback='').strip()
        if tpl:
            return tpl
    except (OSError, configparser.Error):
        pass
    return '{title}-{jobid}-{date}-{time}'


def get_keep_extension(username: str) -> bool:
    """是否保留原文档后缀（控制中心设置页可配置，默认不保留）。

    读取与输出目录同一配置文件（~/.config/org.deepin.dde.pdfprinter/pdfprinter.conf）。
    """
    try:
        home = pwd.getpwnam(username).pw_dir
    except KeyError:
        home = os.path.expanduser('~')
    conf_path = os.path.join(home, '.config', 'org.deepin.dde.pdfprinter', 'pdfprinter.conf')
    try:
        parser = configparser.ConfigParser()
        with open(conf_path, encoding='utf-8') as f:
            parser.read_file(f)
        raw = parser.get('General', 'keepTitleExtension', fallback='').strip().lower()
        if raw in ('true', '1', 'yes'):
            return True
    except (OSError, configparser.Error):
        pass
    return False


def render_filename(tpl: str, title: str, job_id: str, now: float, keep_ext: bool = False) -> str:
    """按模板渲染输出文件名（不含扩展名），并做最终安全清洗。

    - {title} → sanitize_filename(title)（防穿越/注入）；keep_ext=False 时去掉原后缀
    - {jobid} → 仅数字
    - {date} / {time} → 本地时间
    - 未知占位符原样保留；结果再整体 sanitize 一次（防模板注入路径字符）
    """
    safe_title = sanitize_filename(title)
    if not keep_ext:
        # 去掉最后一个点号后缀（如 采购单.txt → 采购单）；无后缀则原样
        dot = safe_title.rfind('.')
        if dot > 0:
            safe_title = safe_title[:dot]
    safe_job = ''.join(c for c in job_id if c.isdigit()) or '0'
    date_s = time.strftime('%Y%m%d', time.localtime(now))
    time_s = time.strftime('%H%M%S', time.localtime(now))
    rendered = tpl.replace('{title}', safe_title) \
                .replace('{jobid}', safe_job) \
                .replace('{date}', date_s) \
                .replace('{time}', time_s)
    # 防模板含路径/分隔符注入
    rendered = sanitize_filename(rendered)
    if not rendered:
        rendered = 'print'
    return rendered


def main():
    # CUPS 传递的参数（argv[0] 是设备 URI）
    if len(sys.argv) < 2 or sys.argv[1] == '--help' or sys.argv[1] == '-h':
        discover()
        return 0

    # 发现模式（单个参数或无参数时 CUPS 调用）
    if len(sys.argv) == 1:
        discover()
        return 0

    job_id = sys.argv[1]
    username = sys.argv[2] if len(sys.argv) > 2 else 'unknown'
    title = sys.argv[3] if len(sys.argv) > 3 else 'print'
    copies = int(sys.argv[4]) if len(sys.argv) > 4 and sys.argv[4].isdigit() else 1
    options = sys.argv[5] if len(sys.argv) > 5 else ''
    filename = sys.argv[6] if len(sys.argv) > 6 else None

    # 读取数据
    if filename and os.path.exists(filename):
        with open(filename, 'rb') as f:
            data = f.read()
    else:
        data = sys.stdin.buffer.read()

    if not data:
        print(f'ERROR: empty print data for job {job_id}', file=sys.stderr)
        return 1

    # 剥离 PJL/JCL 包装头（PPD 的 JCLBegin/JCLToPDFInterpreter 指令），
    # 直到遇到 %PDF 魔数为止。cups-pdf 后端同样处理此步骤。
    pdf_start = data.find(b'%PDF')
    if pdf_start > 0:
        data = data[pdf_start:]

    outdir = get_output_dir(username)
    if outdir is None:
        print('ERROR: 输出目录不安全（家目录解析异常），拒绝写入', file=sys.stderr)
        return 1
    # 文件名模板（控制中心设置页可自定义；默认 {title}-{jobid}-{date}-{time}）
    tpl = get_filename_template(username)
    keep_ext = get_keep_extension(username)
    now = time.time()
    base = render_filename(tpl, title, job_id, now, keep_ext)
    # 保留毫秒防同秒同名覆盖（strftime %f 在 Linux 不支持微秒，手动取）
    ts_ms = int((now - int(now)) * 1000)
    outpath = os.path.join(outdir, f'{base}{ts_ms:03d}.pdf')

    try:
        with open(outpath, 'wb') as f:
            f.write(data)
    except OSError as e:
        print(f'ERROR: 写入 PDF 失败: {e} (outdir={outdir})', file=sys.stderr)
        return 1

    # 文件属主给用户
    try:
        uid = pwd.getpwnam(username).pw_uid
        gid = pwd.getpwnam(username).pw_gid
        os.chown(outpath, uid, gid)
    except (KeyError, PermissionError):
        pass

    print(f'PDF saved to {outpath}', file=sys.stderr)
    return 0


if __name__ == '__main__':
    sys.exit(main())
